#####> xcath xjew xother ####
gss <- gss %>%
  mutate(
    xcath  = case_when(other == 123 | naffil == 4 ~ 1, TRUE ~ 0),
    xjew   = case_when(naffil == 5 ~ 1, TRUE ~ 0),
    xother = case_when(
      other %in% c(11, 17, 29, 30, 33, 58, 59, 60, 61, 62,
                   64, 74, 75, 80, 82, 95, 113, 114, 130, 136,
                   141, 145)                             ~ 1,
      (1 - xev) * naffil == 6                           ~ 1,
      TRUE ~ 0
    )
  )

#####> xnonaff xprotdk ####
gss <- gss %>%
  mutate(
    attend  = zap_labels(attend),
    low_att = attend %in% c(0, 1, 2, 3, 9) | is.na(attend),
    xnonaff = case_when(naffil == 9 ~ 1, TRUE ~ 0),
    xprotdk = case_when(denom == 70 & !low_att ~ 1, TRUE ~ 0),
    xev     = case_when(xprotdk == 1 ~ 1, TRUE ~ xev)
  )

#####> xtn inter ####
gss <- gss %>%
  mutate(
    xtn   = case_when(relig == 11 & denom != 70 & !low_att ~ 1, TRUE ~ 0),
    xev   = case_when(xtn == 1 ~ 1, TRUE ~ xev),
    inter = case_when(relig == 13 & !low_att ~ 1, TRUE ~ 0),
    xev   = case_when(inter == 1 ~ 1, TRUE ~ xev)
  )

#####> reltrad ####
gss <- gss %>%
  mutate(
    reltrad = case_when(
      xnonaff == 1 ~ 7,
      xother  == 1 ~ 6,
      xjew    == 1 ~ 5,
      xcath   == 1 ~ 4,
      xbp     == 1 ~ 3,
      xml     == 1 ~ 2,
      xev     == 1 ~ 1,
      TRUE         ~ 8
    ),
    reltrad = factor(reltrad,
                     levels = c(1, 2, 3, 4, 5, 6, 7, 8),
                     labels = c("evangelical", "mainline", "black protestant",
                                "catholic", "jewish", "other faith",
                                "nonaffiliated", "NA"))
  )

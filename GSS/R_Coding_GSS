library(tidyverse)
library(haven)
## This syntax was translated from Stata by Blake Eggleston ###

## Read the GSS Data in as an object named gss ####
gss <- read_dta("gss.dta") %>% as_tibble()

#####> naffil xaffil ####
gss <- gss %>%
  mutate(
    relig  = zap_labels(relig),
    naffil = case_when(
      relig %in% c(1, 11, 13) ~ 1,
      relig == 2              ~ 4,
      relig == 3              ~ 5,
      relig == 4              ~ 9,
      relig %in% 5:10         ~ 6,
      relig == 12             ~ 6,
      TRUE                    ~ 0
    ),
    xaffil = factor(naffil, levels = c(0, 1, 4, 5, 6, 9),
                    labels = c(NA, "prot", "cath", "jew", "other", "nonaf"))
  )

#####> Black Protestants ####
gss <- gss %>%
  mutate(
    other  = zap_labels(other),
    denom  = zap_labels(denom),
    race   = zap_labels(race),
    bl     = case_when(race == 2 ~ 1, TRUE ~ 0),
    xbp = case_when(
      other %in% c(7, 14, 15, 21, 37, 38, 56, 78, 79, 85,
                   86, 87, 88, 98, 103, 104, 128, 133)   ~ 1,
      denom %in% c(12, 13, 20, 21)                       ~ 1,
      denom * bl %in% c(10, 11, 14, 15, 18, 23, 28)      ~ 1,
      other * bl == 93                                    ~ 1,
      TRUE ~ 0
    )
  )

#####> xev ####
gss <- gss %>%
  mutate(
    wh      = case_when(race == 2 ~ 0, TRUE ~ 1),
    whdenom = denom * wh,
    whother = other * wh,
    xev = case_when(
      other %in% c(2, 3, 5, 6, 9, 10, 12, 13, 16, 18,
                   20, 22, 24, 26, 27, 28, 31, 32, 34, 35, 36,
                   39, 41, 42, 43, 45, 47, 51, 52, 53, 55, 57,
                   63, 65, 66, 67, 68, 69, 76, 77, 83, 84, 90,
                   91, 92, 94, 97, 100, 101, 102, 106, 107, 108,
                   109, 110, 111, 112, 115, 116, 117, 118, 120,
                   121, 122, 124, 125, 127, 129, 131, 132, 134,
                   135, 138, 139, 140, 146)              ~ 1,
      denom %in% c(32, 33, 34, 42)                       ~ 1,
      whdenom %in% c(10, 14, 15, 18, 23)                 ~ 1,
      whother == 93                                      ~ 1,
      xbp == 1                                           ~ 0,
      TRUE ~ 0
    )
  )

#####> xml ####
gss <- gss %>%
